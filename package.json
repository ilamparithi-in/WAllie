{
  "name": "wallie",
  "desktopName": "dev.ilamparithi.wallie.desktop",
  "version": "1.0.0",
  "type": "module",
  "description": "Electron-based WhatsApp Client for Linux with Multi-account and Extensions Support",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/ilamparithi-in/WAllie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilamparithi-in/WAllie.git"
  },
  "bugs": {
    "url": "https://github.com/ilamparithi-in/WAllie/issues"
  },
  "scripts": {
    "clean": "rm -rf dist dist-pack",
    "clean:build": "npm run clean && npm run build",
    "build:preload": "tsc -p tsconfig.preload.json && mv dist/preload/preload/index.js dist/preload/index.cjs && rm -rf dist/preload/preload dist/preload/shared",
    "dev": "npm run build:preload && vite",
    "build": "npm run build:preload && tsc && vite build",
    "version:info": "node scripts/version-helper.cjs",
    "electron:dev": "npm run build:preload && vite",
    "electron:build": "npm run build && node scripts/build-package.cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "linux",
    "electron",
    "multi-account",
    "chrome-extensions"
  ],
  "author": "Ilamparithi M <ilamparithi.in@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
