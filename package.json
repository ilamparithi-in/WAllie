{
  "name": "wallie",
  "version": "1.0.0",
  "type": "module",
  "description": "Electron-based WhatsApp Client for Linux with Multi-account and Extensions Support",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/ilamparithi-in/WAllie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilamparithi-in/WAllie.git"
  },
  "bugs": {
    "url": "https://github.com/ilamparithi-in/WAllie/issues"
  },
  "scripts": {
    "clean": "rm -rf dist dist-pack",
    "clean:build": "npm run clean && npm run build",
    "build:preload": "tsc src/preload/index.ts --module commonjs --target es2020 --outDir dist/preload --rootDir src && mv dist/preload/preload/index.js dist/preload/index.cjs && rm -rf dist/preload/preload dist/preload/shared",
    "dev": "npm run build:preload && vite",
    "build": "npm run build:preload && tsc && vite build",
    "electron:dev": "npm run build:preload && vite",
    "electron:build": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "linux",
    "electron",
    "multi-account",
    "chrome-extensions"
  ],
  "author": "Ilamparithi M",
  "license": "MIT",
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  }
}
